# Copy this file to .env.blog (same folder) and fill with your SMTP creds
# This config enables Ghost to send magic links, invites and password resets.

# Mandatory
mail__transport=smtp
mail__from="Goodmeow Blog <no-reply@goodmeow.my.id>"

# Option A — Generic SMTP
mail__options__host=smtp.yourprovider.com
mail__options__port=587
mail__options__secure=false
mail__options__auth__user=YOUR_SMTP_USERNAME
mail__options__auth__pass=YOUR_SMTP_PASSWORD

# Option B — Gmail (less recommended; needs App Password)
# mail__options__service=Gmail
# mail__options__auth__user=you@gmail.com
# mail__options__auth__pass=APP_PASSWORD

# Option C — Mailgun (example)
# mail__options__service=Mailgun
# mail__options__auth__user=postmaster@sandbox12345.mailgun.org
# mail__options__auth__pass=key-xxxxxxxxxxxxxxxxxxxx

# --- Gravatar API (optional, for local fetch of icons) ---
# GRAVATAR_HASH=md5_of_email
# GRAVATAR_EMAIL=user@example.com   # alternative to GRAVATAR_HASH
# GRAVATAR_API_SECRET=your_api_secret_string

# --- Ghost blog (staging/production) ---
# Preferred: subdomain for blog
GHOST_PUBLIC_URL=https://blog.goodmeow.my.id

# MySQL (Ghost database)
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# SMTP — Oracle Cloud Email Delivery (example; set your region host)
# Docs: https://docs.oracle.com/en-us/iaas/Content/Email/Tasks/configuresmtpconnection.htm
mail__transport=smtp
mail__from="Goodmeow Blog <no-reply@goodmeow.my.id>"
mail__options__host=smtp.email.ap-batam-1.oci.oraclecloud.com
mail__options__port=587
mail__options__secure=false
mail__options__requireTLS=true  # STARTTLS on port 587
mail__options__auth__user=<your-smtp-username>
mail__options__auth__pass="<your-smtp-password>"  # quote if password contains # or special chars
