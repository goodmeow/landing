# Copy this file to .env.blog (same folder) and fill with real credentials.
# docker-compose.blog.yml loads this file to configure Ghost + MySQL.

############################
# Site & Ghost metadata
############################
GHOST_PUBLIC_URL=https://blog.example.com
url=https://blog.example.com

############################
# MySQL database
############################
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

############################
# Ghost DB connection (inside container)
############################
database__client=mysql
database__connection__host=blog_db
database__connection__user=ghost
database__connection__password=change-me
database__connection__database=ghost

############################
# SMTP (Oracle Cloud Email Delivery example)
############################
mail__transport=smtp
mail__from="Example Blog <no-reply@example.com>"
mail__options__host=smtp.example.com
mail__options__port=587
mail__options__secure=false
mail__options__requireTLS=true
mail__options__auth__user=YOUR_SMTP_USERNAME
mail__options__auth__pass=YOUR_SMTP_PASSWORD

# Adjust the SMTP block for other providers as needed.
# Quote complex passwords if they include spaces or `#` characters.
